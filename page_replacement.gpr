--  page_replacement.gpr
--
--  GNAT Project File for Page Replacement Algorithms
--
--  Author: Robert Boettcher
--  Date: July 29, 2026
--

project Page_Replacement is

   -- Source directories
   for Source_Dirs use ("src");

   -- Object directory
   for Object_Dir use "obj";

   -- Executable directory
   for Exec_Dir use "bin";

   -- Main program (if you want to create a test driver)
   -- for Main use ("main.adb");

   -- Source files
   for Source_Files use (
      "page_replacement.ads",
      "page_replacement.adb"
   );

   -- Compiler options
   for Compiler ("ada") use ("gnatmake");

   -- Optimization level
   for Optimization_Level ("ada") use "2";

   -- Debug information
   for Debug_Info_In_Libraries use "true";

   -- Ada standard
   for Ada_Standard use "Ada2022";

   -- Package options
   package Compiler is
      for Default_Switches ("ada") use (
         "-gnatN",  -- No assert pragma checks
         "-gnato",  -- Optimization
         "-gnatp",  -- Suppress info messages
         "-gnatwe"  -- Warnings as errors
      );
   end Compiler;

   -- Linker options
   package Linker is
      for Default_Switches ("ada") use (
         "-static"
      );
   end Linker;

end Page_Replacement;
